[Unit]
Description=WeKnora Lite knowledge service
Documentation=https://github.com/Tencent/WeKnora
After=network-online.target weknora-docreader.service
Wants=network-online.target weknora-docreader.service

[Service]
Type=simple
WorkingDirectory=/media/yinzh/ext/WeKnora
EnvironmentFile=-/media/yinzh/ext/WeKnora/.env.lite
Environment=SSRF_WHITELIST_EXTRA=localhost,127.0.0.1,192.168.30.71
ExecStart=/media/yinzh/ext/WeKnora/WeKnora-lite
Restart=on-failure
RestartSec=3
StandardOutput=append:/media/yinzh/ext/WeKnora/data/lite.log
StandardError=append:/media/yinzh/ext/WeKnora/data/lite.log

[Install]
WantedBy=default.target
